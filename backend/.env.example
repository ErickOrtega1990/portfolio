# ================================================================
# Variables de entorno — API de contacto (portfolio backend)
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a git (solo .env.example, sin secretos).
# ================================================================

# ---- Entorno ----
NODE_ENV=development
PORT=3000

# URL pública del sitio (se usa en las plantillas de correo)
APP_URL=https://erickortegadev.cl

# Orígenes habilitados para CORS (separados por coma)
# En desarrollo, el frontend de Vite corre en el 5173
CORS_ORIGIN=http://localhost:5173

# true si el backend corre detrás de un proxy inverso (nginx, Cloudflare, ...)
TRUST_PROXY=false

# ---- Correo ----
# Buzón que recibe las solicitudes de contacto
CONTACT_EMAIL=contacto@erickortegadev.cl

# Remitente de los correos salientes
MAIL_FROM_NAME=Erick Ortega
# MAIL_FROM=contacto@erickortegadev.cl   (por defecto usa CONTACT_EMAIL)

# ---- SMTP (DATOS SENSIBLES) ----
# Credenciales del buzón que envía los correos.
# Sin estas variables, en desarrollo los correos se simulan por consola.
SMTP_HOST=smtp.tuproveedor.cl
SMTP_PORT=587
# true solo para el puerto 465 (SSL implícito); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=contacto@erickortegadev.cl
SMTP_PASS=cambia-esta-contrasena
